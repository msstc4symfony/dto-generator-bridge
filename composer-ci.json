{
    "name": "msstc4symfony/dto-generator-bridge",
    "description": "Symfony Validator constraints and Serializer attributes for DTOs generated by msstc4php/dto-generator.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Maxim Shamaev",
            "email": "maxim.shamaev@gmail.com"
        }
    ],
    "keywords": [
        "openapi",
        "dto",
        "symfony",
        "validator",
        "serializer",
        "code-generator"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/msstc4php/dto-generator"
        }
    ],
    "require": {
        "php": ">=7.4",
        "msstc4php/dto-generator": "^1.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.6",
        "doctrine/annotations": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.55",
        "infection/infection": "^0.29 || ^0.32",
        "phpdocumentor/reflection-docblock": "^5.6",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^9.6",
        "rector/rector": "^2.1",
        "roave/backward-compatibility-check": "^8.20",
        "roave/security-advisories": "dev-latest",
        "symfony/framework-bundle": "^5.4|^6.4|^7.4|^8.0",
        "symfony/property-access": "^5.4|^6.4|^7.4|^8.0",
        "symfony/property-info": "^5.4|^6.4|^7.4|^8.0",
        "symfony/serializer": "^5.4|^6.4|^7.4|^8.0",
        "symfony/validator": "^5.4|^6.4|^7.4|^8.0"
    },
    "suggest": {
        "symfony/validator": "To validate the generated DTOs",
        "symfony/serializer": "To (de)serialize the generated DTOs",
        "symfony/framework-bundle": "To use DtoGeneratorBundle: the dto-generator:generate command and the warmup check"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "autoload": {
        "psr-4": {
            "Msstc4Symfony\\DtoGeneratorBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Msstc4Symfony\\DtoGeneratorBridge\\Test\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "require": "^6.4|^7.0|^8.0"
        },
        "bundle-standard": {
            "runtime": "php74"
        },
        "dto-generator": {
            "extensions": [
                "Msstc4Symfony\\DtoGeneratorBridge\\SymfonyExtension"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "msstc4php/dto-generator": false,
            "phpstan/extension-installer": true
        },
        "audit": {
            "abandoned": "report"
        }
    }
}
