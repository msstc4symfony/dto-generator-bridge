{
    "name": "msstc4php/dto-generator-bridge-symfony",
    "description": "Symfony Validator constraints and Serializer attributes for DTOs generated by msstc4php/dto-generator.",
    "type": "library",
    "license": "MIT",
    "keywords": ["openapi", "dto", "symfony", "validator", "serializer", "code-generator"],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {"type": "path", "url": "../../msstc4php/dto-generator", "options": {"symlink": true}}
    ],
    "require": {
        "php": ">=7.4",
        "msstc4php/dto-generator": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "suggest": {
        "symfony/validator": "To validate the generated DTOs",
        "symfony/serializer": "To (de)serialize the generated DTOs"
    },
    "autoload": {
        "psr-4": {"MSSTC4PHP\\DtoGeneratorBridgeSymfony\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"MSSTC4PHP\\DtoGeneratorBridgeSymfony\\Tests\\": "tests/"}
    },
    "extra": {
        "dto-generator": {
            "extensions": ["MSSTC4PHP\\DtoGeneratorBridgeSymfony\\SymfonyExtension"]
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {"php": "7.4.33"},
        "allow-plugins": {"msstc4php/dto-generator": false}
    }
}
