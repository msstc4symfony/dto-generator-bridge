{
    "name": "msstc4symfony/dto-generator-bridge",
    "description": "Symfony Validator constraints and Serializer attributes for DTOs generated by msstc4php/dto-generator.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Maxim Shamaev",
            "email": "maxim.shamaev@gmail.com"
        }
    ],
    "keywords": [
        "openapi",
        "dto",
        "symfony",
        "validator",
        "serializer",
        "code-generator"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/msstc4php/dto-generator"
        }
    ],
    "require": {
        "php": ">=7.4",
        "msstc4php/dto-generator": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "suggest": {
        "symfony/validator": "To validate the generated DTOs",
        "symfony/serializer": "To (de)serialize the generated DTOs",
        "symfony/framework-bundle": "To use DtoGeneratorBundle: the dto-generator:generate command and the warmup check"
    },
    "conflict": {
        "symfony/framework-bundle": "<5.4",
        "symfony/symfony": "*"
    },
    "autoload": {
        "psr-4": {
            "Msstc4Symfony\\DtoGeneratorBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Msstc4Symfony\\DtoGeneratorBridge\\Test\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "require": "^6.4|^7.0|^8.0"
        },
        "bundle-standard": {
            "runtime": "php74"
        },
        "dto-generator": {
            "extensions": [
                "Msstc4Symfony\\DtoGeneratorBridge\\SymfonyExtension"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "msstc4php/dto-generator": false
        }
    }
}
